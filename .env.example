# Server
PORT=5001

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=healthapp

# JWT secret (koi bhi lambi random string rakhein)
JWT_SECRET=change_this_to_a_long_random_secret_healthapp_2026
JWT_EXPIRES_IN=30d

# ---- Email (OTP bhejne ke liye) ----
# Gmail: Google Account -> Security -> 2-Step Verification ON -> "App passwords" -> naya password banaiye
# Agar ye khaali chhodenge to OTP terminal (backend console) mein print hoga (sirf testing ke liye)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HealthApp <yourgmail@gmail.com>"
APP_NAME=HealthApp

# ---- AI (food photo se calories) ----
# AI_PROVIDER=gemini ya claude. Khaali chhodein to GEMINI_API_KEY hone par Gemini chalega.
AI_PROVIDER=gemini
AI_DAILY_SCAN_LIMIT=20

# Google Gemini: https://aistudio.google.com/apikey par key banaiye
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Claude (Anthropic): https://console.anthropic.com par key banaiye
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---- Online payment (Razorpay) ----
# https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> URL: https://aapka-server.com/api/payments/webhook , event: payment_link.paid
RAZORPAY_WEBHOOK_SECRET=
# Payment ke baad user kahan jaye (optional)
PAYMENT_CALLBACK_URL=

# Video upload ki max size (MB)
MAX_VIDEO_MB=200

# Photos, reports, PDF, videos kahan save hon. Khaali = backend/uploads.
# Hostinger par app folder se BAHAR ka folder dijiye, jaise /home/u123456789/healthapp-uploads
UPLOAD_DIR=
